# Copy this file to .env and change the secrets before real use.
# SQLite is used by default. For PostgreSQL use, for example:
# DATABASE_URL=postgresql+psycopg://uhs:password@localhost:5432/uhs_kds
DATABASE_URL=sqlite:///uhs_kds.db
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_HOURS=8
# Keep this secret and never change it once records have been imported.
PSEUDONYM_SALT=replace-with-another-long-random-string
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
